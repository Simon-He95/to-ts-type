{
  "publisher": "simonhe",
  "name": "to-ts-type",
  "displayName": "To Ts Type",
  "version": "0.0.15",
  "packageManager": "pnpm@8.15.9",
  "description": "to-ts-type",
  "author": "Simon He <https://github.com/Simon-He95>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/Simon-He95",
  "homepage": "https://github.com/Simon-He95/to-ts-type#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Simon-He95/to-ts-type"
  },
  "bugs": {
    "url": "https://github.com/Simon-He95/to-ts-type/issues"
  },
  "sponsor": {
    "url": "https://github.com/Simon-He95/sponsor"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.cjs",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.77.0"
  },
  "activationEvents": [
    "onCommand:to-ts-type.transform"
  ],
  "contributes": {
    "commands": [
      {
        "command": "to-ts-type.transform",
        "title": "to-ts-type"
      }
    ],
    "keybindings": [
      {
        "command": "to-ts-type.transform",
        "key": "cmd+alt+t",
        "when": "isMac"
      },
      {
        "command": "to-ts-type.transform",
        "key": "ctrl+alt+t",
        "when": "!isMac"
      }
    ]
  },
  "scripts": {
    "dev": "pnpm build --watch",
    "test": "vitest",
    "build": "tsdown src/index.ts --external vscode --format cjs",
    "pack": "vsce package --no-dependencies",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "publish": "vsce publish --no-dependencies",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && pnpm run publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.1",
    "@types/node": "^18.19.130",
    "@types/vscode": "1.77.0",
    "@vscode-use/utils": "0.1.11",
    "@vscode/vsce": "^3.7.1",
    "bumpp": "^9.11.1",
    "eslint": "^9.39.2",
    "lazy-js-utils": "^0.1.49",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
